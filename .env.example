# Make sure we do not  include the trailing slash

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="/api"

# MongoDB connection string (Atlas or local)
MONGODB_URI="mongodb://localhost:27017/lion-shopping"

# Better Auth: generate secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# SMTP for OTP emails. Until SMTP_USER/SMTP_PASS are set, the OTP is printed to the server console
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Lion Cosmetic <no-reply@example.com>"

# Cloudinary product image upload (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="lion-shopping/products"

# Used by `pnpm seed:admin` to create the first admin account
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Google login (later)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
